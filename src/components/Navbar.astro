---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header class="site-header">
  <div class="header-container">
    <a href="#inicio" class="logo">DALTON JAUREGUI</a>
    
    <!--desktop nav -->
    <nav class="desktop-nav">
      <a href="#quienes-somos">{t('nav.about')}</a>
      <a href="#servicios">{t('nav.services')}</a>
      <a href="#proyectos">{t('nav.projects')}</a>
      <a href="#network">{t('nav.network')}</a>
      <a href="#contacto">{t('nav.contact')}</a>

      <div class="lang-switcher">
        <a href={`${import.meta.env.BASE_URL}`} class={lang === 'es' ? 'active' : ''}>ES</a>
        <span class="divider">/</span>
        <a href={`${import.meta.env.BASE_URL}/en/`} class={lang === 'en' ? 'active' : ''}>EN</a>
      </div>
    </nav>

    <!--button mobile menu -->
    <button class="mobile-toggle" aria-label="Abrir menú" aria-expanded="false">
      <span class="menu-label">MENÚ</span>
      <svg class="key-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="7.5" cy="15.5" r="5.5"></circle>
        <path d="M11.5 11.5L21 2v4l-3 3l2 2l-3 3l-1.5-1.5"></path>
      </svg>
    </button>
  </div>

  <!--overlay -->
  <div class="mobile-overlay">
    <nav class="mobile-nav">
      <a href="#quienes-somos" class="mobile-link">Quiénes somos</a>
      <a href="#servicios" class="mobile-link">Servicios</a>
      <a href="#proyectos" class="mobile-link">Proyectos</a>
      <a href="#network" class="mobile-link">Colaboradores</a>
      <a href="#contacto" class="mobile-link">Contacto</a>

      <div class="lang-switcher mobile-link">
        <a href={`${import.meta.env.BASE_URL}`} class={lang === 'es' ? 'active' : ''}>ES</a>
        <span class="divider">/</span>
        <a href={`${import.meta.env.BASE_URL}/en/`} class={lang === 'en' ? 'active' : ''}>EN</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background-color: var(--color-bg);
    z-index: 100;
    border-bottom: 1px solid #eaeaea;

    transition: background-color 0.3s ease;
  }

  .header-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 24px var(--spacing-x);
    display: flex;
    justify-content: space-between;
    align-items: center;

    position: relative;
    z-index: 101;
  }

  .logo {
    font-family: var(--font-heading);
    font-weight: 400;
    text-decoration: none;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .mobile-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: var(--bg-primary);
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    /* transition: opacity 0.4s cubic-bezier(0.25, 1, 0.5, 1); */
    transition: opacity 0.4s ease, overlay 0.4s allow-discrete, display 0.4s allow-discrete;
    opacity: 0;
    z-index: 100;

  }


 .mobile-overlay.is-active {
    opacity: 1;
    pointer-events: auto;
  }


  .mobile-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  .mobile-link {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 6vw, 3rem);
    color: var(--text-primary);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 2px;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.4s ease, transform 0.4s ease, color 0.3s ease;
  }

  .mobile-overlay.is-active .mobile-link {
    opacity: 1;
    transform: translateY(0);
  }
  .mobile-overlay.is-active .mobile-link:nth-child(1) { transition-delay: 0.1s; }
  .mobile-overlay.is-active .mobile-link:nth-child(2) { transition-delay: 0.15s; }
  .mobile-overlay.is-active .mobile-link:nth-child(3) { transition-delay: 0.2s; }
  .mobile-overlay.is-active .mobile-link:nth-child(4) { transition-delay: 0.25s; }
  .mobile-overlay.is-active .mobile-link:nth-child(5) { transition-delay: 0.3s; }

  .mobile-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    z-index: 102;
  }

  .menu-label {
    font-size: 0.75rem;
    letter-spacing: 1px;
    font-weight: 600;
  }

  .desktop-nav {
      display: none;
    }




  @media (min-width: 992px) {
      .mobile-toggle {
        display: none;
      }
      
      .desktop-nav {
        display: flex;
        gap: 40px;
      }

      .desktop-nav a {
        font-family: var(--font-body);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        text-decoration: none;
        color: var(--text-body);
        transition: color 0.3s ease;
      }

      .desktop-nav a:hover {
        color: var(--text-primary);
      }
    }

    .lang-switcher {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    letter-spacing: 1px;
  }

  .lang-switcher a {
    text-decoration: none;
    color: var(--color-accent);
    transition: color 0.3s ease;
  }

  .lang-switcher a:hover {
    color: var(--text-primary);
  }


  .lang-switcher a.active {
    color: var(--text-primary);
    font-weight: 600;
  }

  .lang-switcher .divider {
    color: var(--color-accent);
    opacity: 0.5;
  }


  .mobile-overlay .lang-switcher {
    margin-top: 24px;
    font-size: 1.25rem;
  }


</style>

<script>

  const toggleBtn = document.querySelector('.mobile-toggle');
  const overlay = document.querySelector('.mobile-overlay');
  const mobileLinks = document.querySelectorAll('.mobile-link');
  const menuLabel = document.querySelector('.menu-label');

  function toggleMenu() {
    const isActive = overlay.classList.toggle('is-active');
    

    toggleBtn.setAttribute('aria-expanded', isActive);
    

    if (menuLabel) {
      menuLabel.textContent = isActive ? 'CERRAR' : 'MENÚ';
    }
    

    document.body.style.overflow = isActive ? 'hidden' : '';
  }


  if (toggleBtn) {
    toggleBtn.addEventListener('click', toggleMenu);
  }


  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (overlay.classList.contains('is-active')) {
        toggleMenu();
      }
    });
  });
</script>
