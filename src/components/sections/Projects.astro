---
interface Project {
  id: string;
  category: string;
  credits: string;
  client: string;
  title: string;
  year: string;
  badges: string[];
  mediaType: "video" | "image";
  mediaSrc: string;
  posterSrc?: string;
  description: string;
  technicalSpecs?: {
    master: string;
    sound: string;
  };
}

const projects: Project[] = [
  {
    id: "ident-audiovisual",
    category: "ORIGINAL IP",
    credits: "ELU ANIMATIONS · ARTLIST",
    client: "IDENT",
    title: "AUDIOVISUAL",
    year: "2026",
    badges: ["ORIGINAL IP", "EXECUTIVE PRODUCTION", "SOUND"],
    mediaType: "image",
    mediaSrc: "/assets/projects/ident-audiovisual.jpg",
    description: "Pieza identitaria audiovisual original para Dalton Jáuregui. Masterización DCI 4K a 24fps con diseño sonoro orquestal y licencia comercial integral.",
    technicalSpecs: {
      master: "4096x2160 DCI 4K 24fps .mov / 3840x2160 UHD 4K .mp4",
      sound: "Artlist Original · Epic Orchestral - Royal String / Chroma SFX"
    }
  },
  {
    id: "lisa-vma",
    category: "SHOW",
    credits: "C PRINZ · SMUGGLER",
    client: "LISA",
    title: "VMA'S 2026",
    year: "2026",
    badges: ["SHOW CONTENT", "VFX"],
    mediaType: "image",
    mediaSrc: "/assets/projects/lisa-vma.jpg",
    description: "Dirección creativa de contenidos de pantalla y coordinación de producción escénica para la actuación en directo en los MTV Video Music Awards."
  },
  {
    id: "arca-fxck",
    category: "MUSIC VIDEO",
    credits: "DANIEL SANNWALD · SOMESUCH CO",
    client: "ARCA",
    title: "FXCK",
    year: "2025",
    badges: ["VFX", "COLOR"],
    mediaType: "image",
    mediaSrc: "/assets/projects/arca-fxck.jpg",
    description: "Coproducción ejecutiva, supervisión técnica de efectos visuales y etalonaje digital para pieza musical conceptual."
  },
  {
    id: "under-armour",
    category: "COMMERCIAL",
    credits: "LORIS RUSSIER · DRKT STUDIOS",
    client: "UNDER ARMOUR",
    title: "ATHLETES ONLY",
    year: "2025",
    badges: ["COLOR", "EDITING", "VFX"],
    mediaType: "image",
    mediaSrc: "/assets/projects/under-armour.jpg",
    description: "Campaña audiovisual global orientada al rendimiento deportivo de élite, integrando montaje rítmico de alta velocidad y etalonaje dinámico."
  },
  {
    id: "dudamel-abramovic",
    category: "SHOW",
    credits: "NABIL ELDERKIN",
    client: "DUDAMEL & ABRAMOVIĆ",
    title: "TEATRO DI SAN CARLO",
    year: "2025",
    badges: ["AI", "COLOR", "EDITING", "VFX"],
    mediaType: "image",
    mediaSrc: "/assets/projects/dudamel-abramovic.jpg",
    description: "Producción ejecutiva documental y diseño escénico para la colaboración artística entre Gustavo Dudamel y Marina Abramović en Nápoles."
  },
  {
    id: "nas-dj-premier",
    category: "MUSIC VIDEO",
    credits: "JEAN-CHARLES CHARAVIN · GOOD COMPANY",
    client: "NAS & DJ PREMIER",
    title: "GIT READY",
    year: "2024",
    badges: ["AI", "COLOR", "EDITING", "SOUND", "VFX"],
    mediaType: "image",
    mediaSrc: "/assets/projects/nas-premier.jpg",
    description: "Producción audiovisual y postproducción de acabado para el sencillo conmemorativo, combinando cinematografía 35mm y secuencias asistidas por IA."
  }
];
---

<section id="proyectos" class="projects-section">
  <div class="container">
    
    <header class="section-header">
      <span class="tag">03 / PROYECTOS SELECCIONADOS</span>
      <h2 class="section-title">Historias que trascienden.</h2>
      <p class="section-subtitle">
        Iniciativas y producciones que combinan rigor estratégico, talento creativo y estándares de ejecución técnica.
      </p>
    </header>

    <div class="projects-accordion">
      {projects.map((project) => (
        <article class="project-item" data-project-id={project.id}>
          <button 
            type="button" 
            class="project-trigger" 
            aria-expanded="false" 
            aria-controls={`drawer-${project.id}`}
          >
            <div class="meta-row">
              <span class="category-credits">{project.category} · {project.credits}</span>
              <span class="year">{project.year}</span>
            </div>

            <div class="heading-row">
              <h3 class="client-name">{project.client}</h3>
              <span class="project-title">{project.title}</span>
            </div>

            <div class="badges-row">
              <span 
                class="toggle-pill" 
                data-open-label="OCULTAR" 
                data-closed-label="VER CONTENIDO"
              >
                VER CONTENIDO
              </span>
              {project.badges.map((badge) => (
                <span class="badge">{badge}</span>
              ))}
            </div>
          </button>

          <div id={`drawer-${project.id}`} class="project-drawer" hidden>
            <div class="drawer-content">
              <div class="media-container">
                {project.mediaType === "video" ? (
                  <video 
                    src={project.mediaSrc} 
                    poster={project.posterSrc} 
                    autoplay 
                    loop 
                    muted 
                    playsinline
                  />
                ) : (
                  <img 
                    src={project.mediaSrc} 
                    alt={`${project.client} - ${project.title}`} 
                    loading="lazy" 
                  />
                )}
              </div>

              <div class="info-block">
                <p class="description">{project.description}</p>
                {project.technicalSpecs && (
                  <div class="specs-block">
                    <p class="spec-line">
                      <span class="spec-label">MASTER:</span> {project.technicalSpecs.master}
                    </p>
                    <p class="spec-line">
                      <span class="spec-label">SOUND:</span> {project.technicalSpecs.sound}
                    </p>
                  </div>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<script>
  function initAccordion() {
    const triggers = document.querySelectorAll<HTMLButtonElement>(".project-trigger");

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const item = trigger.closest<HTMLElement>(".project-item");
        if (!item) return;

        const drawer = item.querySelector<HTMLElement>(".project-drawer");
        const togglePill = item.querySelector<HTMLElement>(".toggle-pill");
        if (!drawer || !togglePill) return;

        const isExpanded = trigger.getAttribute("aria-expanded") === "true";

        document.querySelectorAll<HTMLElement>(".project-item").forEach((otherItem) => {
          if (otherItem !== item) {
            const otherTrigger = otherItem.querySelector<HTMLButtonElement>(".project-trigger");
            const otherDrawer = otherItem.querySelector<HTMLElement>(".project-drawer");
            const otherPill = otherItem.querySelector<HTMLElement>(".toggle-pill");

            if (otherTrigger && otherDrawer && otherPill) {
              otherTrigger.setAttribute("aria-expanded", "false");
              otherDrawer.hidden = true;
              otherItem.classList.remove("is-open");
              otherPill.textContent = otherPill.getAttribute("data-closed-label") || "VER CONTENIDO";
            }
          }
        });

        if (isExpanded) {
          trigger.setAttribute("aria-expanded", "false");
          drawer.hidden = true;
          item.classList.remove("is-open");
          togglePill.textContent = togglePill.getAttribute("data-closed-label") || "VER CONTENIDO";
        } else {
          trigger.setAttribute("aria-expanded", "true");
          drawer.hidden = false;
          item.classList.add("is-open");
          togglePill.textContent = togglePill.getAttribute("data-open-label") || "OCULTAR";
        }
      });
    });
  }

  initAccordion();
  document.addEventListener("astro:after-swap", initAccordion);
</script>

<style>
  .projects-section {
    background-color: var(--color-moon);
    color: var(--color-granola);
    padding: clamp(80px, 12vh, 160px) var(--spacing-x);
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: clamp(48px, 8vh, 80px);
  }

  .tag {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-granola);
    opacity: 0.8;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 400;
    margin: 16px 0;
    color: var(--color-granola);
  }

  .section-subtitle {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 720px;
    color: var(--color-granola);
    opacity: 0.85;
  }

  .projects-accordion {
    border-top: 1px solid color-mix(in srgb, var(--color-woods) 30%, transparent);
  }

  .project-item {
    border-bottom: 1px solid color-mix(in srgb, var(--color-woods) 25%, transparent);
    transition: background-color 0.3s ease;
  }

  .project-item.is-open {
    background-color: color-mix(in srgb, var(--color-woods) 8%, transparent);
  }

  .project-trigger {
    width: 100%;
    background: transparent;
    border: none;
    padding: 36px 0;
    text-align: left;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-granola);
    opacity: 0.65;
  }

  .heading-row {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
  }

  .client-name {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3.5vw, 2.75rem);
    font-weight: 400;
    color: var(--color-granola);
    letter-spacing: 1px;
    margin: 0;
    line-height: 1.1;
  }

  .project-title {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2.3rem);
    font-style: italic;
    font-weight: 400;
    color: color-mix(in srgb, var(--color-granola) 55%, transparent);
    line-height: 1.1;
  }

  .badges-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 6px;
  }

  .toggle-pill {
    font-family: var(--font-body);
    font-size: 0.65rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-granola);
    border: 1px solid var(--color-granola);
    padding: 4px 10px;
    border-radius: 2px;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .project-item.is-open .toggle-pill {
    background-color: var(--color-granola);
    color: var(--color-moon);
  }

  .badge {
    font-family: var(--font-body);
    font-size: 0.65rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-granola);
    border: 1px solid color-mix(in srgb, var(--color-woods) 50%, transparent);
    padding: 4px 8px;
    border-radius: 2px;
    opacity: 0.75;
  }

  .project-drawer {
    padding-bottom: 40px;
  }

  .drawer-content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .media-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: color-mix(in srgb, var(--color-woods) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-woods) 30%, transparent);
  }

  .media-container img,
  .media-container video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .info-block {
    max-width: 820px;
  }

  .description {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-granola);
    opacity: 0.85;
    margin: 0 0 16px 0;
  }

  .specs-block {
    border-top: 1px solid color-mix(in srgb, var(--color-woods) 20%, transparent);
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .spec-line {
    font-family: var(--font-body);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-granola);
    opacity: 0.6;
    margin: 0;
  }

  .spec-label {
    letter-spacing: 1.5px;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .project-trigger {
      padding: 24px 0;
    }

    .heading-row {
      gap: 6px;
    }

    .meta-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }
  }
</style>