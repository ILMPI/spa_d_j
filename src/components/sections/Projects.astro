---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

interface MediaItem {
  type: "video" | "image";
  src: string;
  poster?: string;
}

interface Project {
  id: string;
  category: string;
  credits: string;
  client: string;
  title: string;
  year: string;
  badges: string[];
  media: MediaItem[];
  description: string;
  technicalSpecs?: {
    master: string;
    sound: string;
  };
}

const projects: Project[] = [
  {
    id: "ident-audiovisual",
    category: "ORIGINAL IP",
    credits: "ELU ANIMATIONS · ARTLIST",
    client: "IDENT",
    title: "AUDIOVISUAL",
    year: "2026",
    badges: ["ORIGINAL IP", "EXECUTIVE PRODUCTION", "SOUND"],
    media: [
      {type: "image", src: "/assets/projects/ident-audiovisual.jpg"}
    ],
    description: "Pieza identitaria audiovisual original para Dalton Jáuregui. Masterización DCI 4K a 24fps con diseño sonoro orquestal y licencia comercial integral.",
    technicalSpecs: {
      master: "4096x2160 DCI 4K 24fps .mov / 3840x2160 UHD 4K .mp4",
      sound: "Artlist Original · Epic Orchestral - Royal String / Chroma SFX"
    }
  },
{
    id: "private-dining-biennale",
    category: "BUSINESS & CORPORATE",
    credits: "PRIVATE OFFICE · CHEF RESIDENCY",
    client: "BIENNALE DI VENEZIA",
    title: "PRIVATE HOSTING & GOURMET",
    year: "2025",
    badges: ["GOURMET", "HOSPITALITY", "EVENTS"],
        media: [
      {type: "image", src: "/assets/projects/venice-gourmet.jpg"}
    ],
    description: "Diseño de experiencia gastronómica privada, maridaje de autor y gestión integral de hospitalidad para patronos y coleccionistas internacionales."
  },
{
    id: "artist-management-tour",
    category: "CULTURE & CREATIVE",
    credits: "LIVE ENTERTAINMENT · SONY MUSIC",
    client: "GIRA INTERNACIONAL",
    title: "TOUR DIRECTION & BOOKING",
    year: "2025",
    badges: ["ARTIST MANAGEMENT", "LIVE PRODUCTION", "MUSIC"],
    media: [
      {type: "image", src: "/assets/projects/artist-tour.jpg"}
    ],
    description: "Representación estratégica, producción técnica de directo y coordinación logística de movilidad premium a lo largo de 14 recintos europeos."
  },
{
    id: "luxury-mobility-summit",
    category: "BUSINESS & CORPORATE",
    credits: "MOBILITY DESK · PRIVATE FLEET",
    client: "GLOBAL ASSET FORUM",
    title: "TRANSPORT & LOGISTICS",
    year: "2024",
    badges: ["LOGISTICS", "MOBILITY", "OPERATIONS"],
    media: [
      {type: "image", src: "/assets/projects/summit-logistics.jpg"}
    ],
    description: "Operativa integral de transporte premium, custodia y traslados privados para delegaciones institucionales durante el foro de inversión."
  },
{
    id: "documentary-film",
    category: "CULTURE & CREATIVE",
    credits: "STUDIO PRODUCTION · 35MM",
    client: "LARGOMETRAJE DOCUMENTAL",
    title: "MEMORIA Y TERRITORIO",
    year: "2024",
    badges: ["AUDIOVISUAL", "DIRECTION", "COLOR"],
    media: [
      {type: "image", src: "/assets/projects/documentary-territorio.jpg"},
      {type: "video", src: "/assets/projects/house.mp4"}
    ],
